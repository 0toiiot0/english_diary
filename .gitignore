# ─── 환경변수 (최우선) ───────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# 예외: 템플릿은 커밋한다
!.env.example

# ─── 의존성 ─────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js 빌드 산출물 ────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ─── 테스트 / 커버리지 ──────────────────────────
/coverage

# ─── 배포 ───────────────────────────────────────
.vercel

# ─── 로그 ───────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

